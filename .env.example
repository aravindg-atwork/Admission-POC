# Copy to .env and fill in. The backend reads these from the environment.
# NEVER commit a real .env - it is gitignored.

# --- Embedding service (Dockerized nomic-embed-text) ---
# The API key you generated at http://localhost:8000/admin for this backend.
EMBEDDING_API_KEY=

# --- Self-hosted embeddings (BGE-M3, multilingual) ---
# Set EMBEDDING_PROVIDER=selfhosted to route embeddings through
# SELFHOSTED_URL/SELFHOSTED_API_KEY (see below) instead of the local
# nomic-embed-text-v1 service above. Point: nomic-embed-text doesn't align
# Hindi/Marathi/Tamil with English closely enough for a native-script
# question to reliably retrieve the right English prospectus chunks, so
# every non-English question currently pays for a translate-to-English round
# trip before retrieval - BGE-M3 could remove that step. Re-ingest every
# project after switching - the vector space changes, so old vectors are
# meaningless against new query embeddings.
EMBEDDING_PROVIDER=local
SELFHOSTED_EMBEDDING_MODEL=bge-m3

# --- Sarvam AI (Hindi/Marathi/Tamil + English chat, cloud) ---
# Get a key at https://dashboard.sarvam.ai . When empty, the backend falls back
# to the local model (gemma2:2b) for all languages.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-30b
# Charge safety: max Sarvam cloud calls/day before auto-falling back to local.
SARVAM_DAILY_LIMIT=150

# --- Indic TTS (AI4Bharat indic-parler-tts, gated on HuggingFace) ---
# 1. Log into huggingface.co, open ai4bharat/indic-parler-tts, click "Agree and
#    access repository".
# 2. Create a read token at huggingface.co/settings/tokens and paste it below.
# This is only read by the indic-tts-service container - pass it via
# `docker run -e HF_TOKEN=...`, not committed here.
HF_TOKEN=

# --- Local models (Ollama) ---
MODEL_LOCAL=gemma2:2b
MODEL_FALLBACK=llama3.1
OLLAMA_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m

# --- Self-hosted LLM API (OpenAI-shaped; POST /v1/chat, not /v1/chat/completions) ---
# Team-run server exposing several models. Set CHAT_FALLBACK=selfhosted below
# to use this instead of local Ollama as the non-Sarvam engine. Routed by
# language per-request (see providers.SelfHostedProvider.chat): non-Latin
# script (Hindi/Marathi/Tamil) goes to SELFHOSTED_MODEL_INTL, everything else
# to SELFHOSTED_MODEL_EN. Check what's actually running before setting either
# - it drifts:
#   curl SELFHOSTED_URL/v1/models -H "Authorization: Bearer $SELFHOSTED_API_KEY"
SELFHOSTED_URL=
SELFHOSTED_API_KEY=
SELFHOSTED_MODEL_EN=glm-4-9b-chat
SELFHOSTED_MODEL_INTL=sarvam-1-gguf-Q4_K_M

# --- Chat provider selection ---
# CHAT_PRIMARY: sarvam (cloud, capped) is the default. CHAT_FALLBACK: ollama
# (local) or selfhosted (the server above) - whichever answers when Sarvam is
# unconfigured, over its daily cap, or fails.
CHAT_PRIMARY=sarvam
CHAT_FALLBACK=ollama

# --- Prospectus auto-refresh (Firecrawl, https://firecrawl.dev) ---
# Detects when a project's live source URL (set per-project in the admin
# console) changes and re-ingests automatically. Get a key at
# firecrawl.dev/app/api-keys, or self-host Firecrawl and point FIRECRAWL_URL at
# it. Leave FIRECRAWL_API_KEY empty to disable watching entirely (manual
# upload via the admin console still works either way).
FIRECRAWL_API_KEY=
FIRECRAWL_URL=https://api.firecrawl.dev
PROSPECTUS_WATCH_INTERVAL_HOURS=6

# --- Admin / server ---
ADMIN_TOKEN=change-me-before-deploy
PORT=5050
