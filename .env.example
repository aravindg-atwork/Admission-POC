# Copy to .env and fill in. The backend reads these from the environment.
# NEVER commit a real .env - it is gitignored.

# --- Embedding service (Dockerized nomic-embed-text) ---
# The API key you generated at http://localhost:8000/admin for this backend.
EMBEDDING_API_KEY=

# --- Sarvam AI (Hindi/Marathi/Tamil + English chat, cloud) ---
# Get a key at https://dashboard.sarvam.ai . When empty, the backend falls back
# to the local model (gemma2:2b) for all languages.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-m

# --- Local models (Ollama) ---
MODEL_LOCAL=gemma2:2b
MODEL_FALLBACK=llama3.1
OLLAMA_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m

# --- Admin / server ---
ADMIN_TOKEN=change-me-before-deploy
PORT=5050
