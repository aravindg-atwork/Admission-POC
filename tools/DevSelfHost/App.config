<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="ChatProvider" value="Ollama" />
    <add key="OllamaBaseUrl" value="http://localhost:11434" />
    <add key="OllamaModel" value="llama3.1" />
    <add key="ClaudeApiKey" value="" />
    <add key="ClaudeModel" value="claude-sonnet-5" />
    <add key="EmbeddingServiceUrl" value="http://localhost:8000" />
    <add key="EmbeddingServiceApiKey" value="" />
    <add key="VectorStorePath" value="App_Data/vector-store.json" />
    <add key="ProspectusStoragePath" value="App_Data/prospectus" />
    <add key="AssistantMode" value="Local" />
    <add key="RemoteAssistantServiceUrl" value="http://localhost:9000" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
