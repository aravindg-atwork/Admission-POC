<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="eligibility-age-fix" name="Eligibility Answer Flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="How a B.V.Sc. Eligibility Question Gets Answered&#10;(and why the age rule never shows up in the reply)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="180" y="0" width="620" height="60" as="geometry" />
        </mxCell>

        <!-- Start -->
        <mxCell id="start" value="Student asks a question&#10;about B.V.Sc. eligibility" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="360" y="90" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Decision 1 -->
        <mxCell id="dec1" value="Did the student share their&#10;own marks and category?&#10;(e.g. &quot;I have 60%, unreserved&quot;)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="200" width="260" height="120" as="geometry" />
        </mxCell>

        <!-- Left branch: general / no personal marks -->
        <mxCell id="procB1" value="System searches the official&#10;prospectus document for the&#10;matching eligibility section" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="procB2" value="AI writes a friendly answer&#10;using ONLY that document text&#10;(marks needed, subjects, entrance exam)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- Right branch: personal marks given -->
        <mxCell id="procA1" value="Computer works out&#10;Pass or Fail on the marks,&#10;using the exact rule (no guessing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="380" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="procA2" value="AI turns that result into&#10;a friendly sentence, told to use&#10;ONLY: marks, subjects, entrance exam" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="490" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- Shared rule box -->
        <mxCell id="rule" value="Both paths are told the same rule:&#10;&quot;Never mention the 17-years-old age&#10;requirement — even if it sits right next&#10;to the marks rule in the source text.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="620" width="280" height="100" as="geometry" />
        </mxCell>

        <!-- Final answer -->
        <mxCell id="finalAnswer" value="Final answer shown to the student:&#10;marks requirement + entrance exam only&#10;— no mention of age at all" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="760" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- Cache clear -->
        <mxCell id="cache" value="Old cached answers are cleared&#10;on every programme, so leftover&#10;replies with the age line disappear" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="880" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- End -->
        <mxCell id="end" value="Student gets a clean,&#10;accurate eligibility answer" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="360" y="1000" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Side note -->
        <mxCell id="note1" value="Why two paths at all?&#10;A plain question like &quot;What is the&#10;eligibility for B.V.Sc.?&quot; never mentions&#10;the student's own marks, so it takes the&#10;left path (search + write). Only a message&#10;like &quot;I have 60%, am I eligible?&quot; takes&#10;the right path (calculate + phrase)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fffce0;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="640" y="200" width="280" height="150" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;" edge="1" parent="1" source="start" target="dec1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;fontStyle=1;fontColor=#d6b656;" edge="1" parent="1" source="dec1" target="procB1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;fontStyle=1;fontColor=#b85450;" edge="1" parent="1" source="dec1" target="procA1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="procB1" target="procB2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="procA1" target="procA2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="procB2" target="rule">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="procA2" target="rule">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="rule" target="finalAnswer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="finalAnswer" target="cache">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="cache" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
