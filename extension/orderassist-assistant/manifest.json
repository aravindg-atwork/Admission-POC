{
  "manifest_version": 3,
  "name": "OrderAssist Catalogue Assistant",
  "version": "0.3.11",
  "description": "When sending a quotation or proposal, automatically finds the matching brochure from your Google Drive catalogue and attaches it — zero config required.",
  "key": "",
  "permissions": [
    "storage",
    "identity",
    "scripting",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.orderassist.in/*"],
      "js": ["interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://app.orderassist.in/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "oauth2": {
    "client_id": "285946928264-cmk4lsg5n9f6llkj19srokj4cuahmtjb.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.readonly"
    ]
  }
}
